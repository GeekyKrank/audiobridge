{
  "name": "soundbridge",
  "private": true,
  "version": "0.1.0",
  "description": "Share a Chrome tab's audio into a Discord voice channel through your own server.",
  "workspaces": ["server"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run dev -w server",
    "build": "npm run build -w server",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w server",
    "deploy-commands": "npm run deploy-commands -w server"
  }
}
