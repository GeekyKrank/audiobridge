# SoundBridge server configuration.
# Copy to server/.env and fill in. NEVER commit the real .env (it's in .gitignore).

# ---------- Discord (https://discord.com/developers/applications) ----------
# Set to false to run without Discord (local test mode: use RECORD_DIR to hear the result).
DISCORD_ENABLED=true
# Bot token: Application -> Bot -> Reset Token. Keep it secret.
DISCORD_TOKEN=
# Application ID: Application -> General Information.
DISCORD_CLIENT_ID=
# Your server's ID (Developer Mode on, right-click server icon -> Copy Server ID).
DISCORD_GUILD_ID=
# Comma-separated user IDs allowed to use the slash commands. Empty = everyone in the server.
ALLOWED_USER_IDS=
# Optional: voice channel to join when the extension doesn't pick one.
DEFAULT_VOICE_CHANNEL_ID=
# Leave the voice channel when sharing stops (otherwise the bot stays until /leave or the channel empties).
LEAVE_ON_STOP=false

# ---------- Extension connection ----------
# Shared secret the extension must send. Generate with:  npm run gen-token
ACCESS_TOKEN=
# Where the server listens. Keep 127.0.0.1 in production (Caddy in front provides HTTPS).
HOST=127.0.0.1
PORT=8787
# true when running behind Caddy (uses X-Forwarded-For for rate limiting).
TRUST_PROXY=false
# Optional: lock the server to your extension's ID (shown on chrome://extensions).
EXTENSION_ID=

# ---------- Audio ----------
# Default server-side buffer (the extension's Buffer setting overrides it). 100-3000.
BUFFER_MS=400
# If more than this is buffered, old audio is dropped so the delay can't grow.
MAX_BUFFER_MS=1500
# Optional: also save every stream as .ogg in this folder (debugging / local test).
RECORD_DIR=

# debug | info | warn | error
LOG_LEVEL=info
