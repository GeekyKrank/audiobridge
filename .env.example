# Copy this file to server/.env and fill in the values. NEVER commit the real .env.

# --- Discord (from https://discord.com/developers/applications) ---
# Bot token: Application -> Bot -> Reset Token. Keep it secret.
DISCORD_TOKEN=
# Application ID: Application -> General Information -> Application ID.
DISCORD_CLIENT_ID=
# Your Discord server ID (right-click server icon -> Copy Server ID; needs Developer Mode).
# Slash commands are registered to this server only, so they appear instantly.
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs allowed to control the bot. Leave empty to allow
# anyone in the server (not recommended).
ALLOWED_USER_IDS=

# debug | info | warn | error
LOG_LEVEL=info
